{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/evidence-timeline.schema.json",
  "title": "Evidence Timeline",
  "type": "object",
  "required": ["id", "title", "description", "updated", "events"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "updated": { "type": "string", "format": "date" },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "required": ["url", "title", "publisher", "type", "accessed", "archive_status"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "title": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "minLength": 1 },
        "type": {
          "enum": ["official_announcement", "official_research", "official_system_card", "official_product_documentation", "official_legal_or_policy_document", "frontier_voice_post", "frontier_voice_talk", "external_reporting", "independent_research", "public_commentary", "personal_archive"]
        },
        "published": { "type": "string", "pattern": "^\\d{4}(-\\d{2})?(-\\d{2})?$" },
        "accessed": { "type": "string", "format": "date" },
        "author_or_speaker": { "type": "string" },
        "claim_scope": { "type": "string" },
        "consent_status": { "enum": ["public", "permissioned", "pending_review", "excluded"] },
        "archive_status": { "enum": ["live", "archived", "missing", "context_dependent"] },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["id", "date", "date_precision", "title", "summary", "sources", "evidence_status", "confidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "date": { "type": "string", "pattern": "^\\d{4}(-\\d{2})?(-\\d{2})?$" },
        "date_precision": { "enum": ["day", "month", "year", "range", "estimated"] },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "record_type": { "enum": ["release", "research", "capability_signal", "product_change", "public_statement", "policy_response", "social_effect", "proposal", "dispute", "open_question"] },
        "timeline_lanes": {
          "type": "array",
          "items": { "enum": ["chronology", "capability", "product", "frontier_voices", "social_transition", "disputes"] },
          "uniqueItems": true
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        },
        "evidence_status": { "enum": ["verified", "proposed", "disputed", "incomplete"] },
        "confidence": { "enum": ["high", "medium", "low"] },
        "interpretation": { "type": "string" },
        "capability_implication": { "type": "string" },
        "reliability_note": { "type": "string" },
        "social_implication": { "type": "string" },
        "disputes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "related_events": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        },
        "open_questions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "updated": {
          "type": "string",
          "format": "date"
        }
      },
      "additionalProperties": false
    }
  }
}
