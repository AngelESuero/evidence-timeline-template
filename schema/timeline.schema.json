{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/evidence-timeline.schema.json",
  "title": "Evidence Timeline",
  "type": "object",
  "required": ["id", "title", "description", "updated", "events"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "updated": { "type": "string", "format": "date" },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "required": ["url", "title", "publisher", "type", "accessed"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "title": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "minLength": 1 },
        "type": {
          "enum": ["primary", "official_interpretive", "reporting", "commentary", "personal_archive"]
        },
        "accessed": { "type": "string", "format": "date" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["id", "date", "date_precision", "title", "summary", "sources", "evidence_status", "confidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "date": { "type": "string", "pattern": "^\\d{4}(-\\d{2})?(-\\d{2})?$" },
        "date_precision": { "enum": ["day", "month", "year", "range", "estimated"] },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        },
        "evidence_status": { "enum": ["verified", "proposed", "disputed", "incomplete"] },
        "confidence": { "enum": ["high", "medium", "low"] },
        "interpretation": { "type": "string" },
        "disputes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "related_events": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        }
      },
      "additionalProperties": false
    }
  }
}

