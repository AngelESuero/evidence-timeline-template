{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/evidence-timeline-proposal.schema.json",
  "title": "Evidence Timeline Proposal",
  "type": "object",
  "required": ["proposal_id", "target_timeline", "review_status", "candidate_event", "review_notes"],
  "properties": {
    "proposal_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "target_timeline": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "review_status": { "enum": ["needs_review", "approved", "rejected"] },
    "candidate_event": {
      "allOf": [
        { "$ref": "timeline.schema.json#/$defs/event" },
        {
          "type": "object",
          "properties": {
            "evidence_status": { "const": "proposed" }
          }
        }
      ]
    },
    "review_notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}

